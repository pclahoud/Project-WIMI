# WIMI application data (user databases, media, plugins) — never commit
app_data/
# wimi-test (CDP regression suite) writes its own isolated app_data dir
# so live tests don't trample the developer's real data.
app_data_test/
*.db-shm
*.db-wal
*.lbdb

# wimi-test failure artifacts (screenshots, console + network logs) —
# regenerated on every CI run, uploaded as an artifact for 14 days.
pytest_artifacts/

# User databases (but keep schema files)
/databases/*.db
!/databases/schema/

# Backup files
*.bak
*.backup
*_backup.*
*.old

# Configuration files with sensitive data
config.ini
secrets.json
*.key
*.pem

# PII denylist for scripts/publish_release.py — local-only by design
.publish_denylist.txt

# Test artifacts
.pytest_cache/
.tox/
htmlcov/
.coverage
coverage.xml
*.cover

# Documentation build
/docs/_build/
/docs/_static/
/docs/_templates/

# Package files
*.tar.gz
*.zip
*.7z
*.rar

# Error logs and debug files
*.stackdump
/core.[0-9]*

# Prebuilt llama.cpp binaries, staged for a local-model feature that has not
# been decided yet (FUTURE_VISION.md, "AI/ML integration approach?"). 44MB of
# Windows x86-64 DLLs that nothing in the tree references, and which
# publish_release.py would carry to the public mirror once committed. Keep
# them on disk, out of the history.
/vendor/

# Agent worktrees and scratch output. Full repo copies and run artifacts
# that nothing references; `git add -A` would otherwise commit them, and
# publish_release.py snapshots the committed tree to the public mirror.
/.claude/worktrees/
/artifacts/

# npm residue. Frontend libraries are VENDORED under src/web/js/lib/ and
# src/web/lib/ -- there is no package manager in this project, and a
# stray node_modules/ contradicts that in the published tree.
/node_modules/
/package.json
/package-lock.json
