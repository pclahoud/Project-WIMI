# Coverage configuration.
#
# This file exists because coverage.py does NOT read pytest.ini. It reads
# .coveragerc, pyproject.toml, setup.cfg and tox.ini only -- and this repo has
# none of the other three. The [coverage:run] / [coverage:report] /
# [coverage:html] sections that used to sit in pytest.ini were therefore inert
# for their whole life; pytest.ini now points here instead. (#96)
#
# The `--cov=src/database` and `--cov-fail-under=80` flags stay in pytest.ini's
# addopts, because those are pytest-cov's own command-line options rather than
# coverage.py configuration.

[run]
source = src/database

# graph.py is gated on `real_ladybug`, a graph library that was evaluated and
# removed on 2026-08-14 and must never be reinstalled. `_graph_available` is
# False in every environment, so the bulk of the module is unreachable and its
# four test files (tests/database/test_graph_*.py) cannot run at all -- they are
# 82 of the 83 documented known failures.
#
# Measuring 447 statements that no test is permitted to reach held the total at
# 78% and made --cov-fail-under=80 impossible to satisfy, so `pytest` exited
# non-zero on a healthy tree and the exit code stopped meaning anything. With
# graph.py omitted the same run reports 81%.
#
# This omits unreachable code, not untested code. If real_ladybug ever returns,
# delete this entry rather than raising the threshold around it.
omit =
    */tests/*
    */__pycache__/*
    */site-packages/*
    */database/domains/graph.py

[report]
precision = 2
show_missing = True
skip_covered = False

# Repeated from [run] deliberately. `[run] omit` filters at collection time and
# `[report] omit` filters an existing data file, so a plain `coverage report`
# over a .coverage collected before this change would otherwise still show
# graph.py. Keep the two lists identical.
omit =
    */tests/*
    */__pycache__/*
    */site-packages/*
    */database/domains/graph.py

[html]
directory = htmlcov
